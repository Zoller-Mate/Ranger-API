{
  "name": "csgo-api",
  "version": "0.0.0",
  "description": "The REST API and the manager for the graduation project 'csgo'",
  "main": "build/server.js",
  "scripts": {
    "build": "npx tsc",
    "postbuild": "copyfiles -u 1 \"src/**/*.{png,jpg,ico,pug,css,map,html,js}\" build",
    "predebug": "echo Debug for the last build starting...",
    "debug": "npx ndb build/index.js",
    "prod": "node build/index.js",
    "dev": "npx tsx watch src/index.ts",
    "css:compile": "sass src/api/_views/scss/main.scss:src/api/views/css/main.css",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit push",
    "db:reset": "npx tsx src/db/scripts/resetDb.ts && npm run db:migrate",
    "db:seed": "npx tsx src/db/scripts/seedDb.ts",
    "drizzle-studio": "npx drizzle-kit studio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kristofforis/CSGO-API.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kristofforis/CSGO-API/issues"
  },
  "homepage": "https://github.com/kristofforis/CSGO-API#readme",
  "dependencies": {
    "@socket.io/admin-ui": "^0.5.1",
    "bcrypt": "^6.0.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "chalk": "^5.6.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cropperjs": "^1.6.1",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.7.0",
    "google-libphonenumber": "^3.2.43",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jquery": "^4.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^7.0.11",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "pug": "^3.0.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "validate-currency-code": "^0.1.3",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.6",
    "@types/pug": "^2.0.10",
    "@types/qrcode": "^1.5.6",
    "@types/socket.io": "^3.0.1",
    "@types/ws": "^8.18.1",
    "copyfiles": "^2.4.1",
    "drizzle-kit": "^0.31.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "sass": "^1.97.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0"
  }
}
