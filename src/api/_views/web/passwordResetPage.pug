extends layout

block title
    title Jelszó visszaállítás

block scripts
    script(src='/js/passwordReset.js' defer)

block content
    .d-flex.justify-content-center.align-items-center.container
        .form-container.w-50.d-flex.flex-column.mt-5.align-items-center
            h2.text-center Állítson be magának új jelszavat!
            hr.w-100
            .alert.alert-danger.d-none#resetPasswordError(role="alert") A jelszavak nem eggyeznek!
            .alert.alert-danger.d-none#resetTokenError(role="alert") A jelszó módosítási lehetőség lejárt, kérjen új módosítási kérelmet!
            form.mt-2.w-100#resetForm
                input.d-none#token(disabled, value=token)
                .mb-3
                    label.form-label.w-100(for="passwordReset") Jelszó
                    input#passwordReset.form-control(type="password", required)
                .mb-3
                    label.form-label.w-100(for="passwordConfirm") Jelszó újra
                    input#passwordConfirm.form-control(type="password", required)
                button.btn.btn-primary.w-50.d-block(type="submit") Jelszó módosítása

