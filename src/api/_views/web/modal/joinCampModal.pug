.modal.fade#joinCampModal(tabindex="-1", aria-labelledby="joinCampModalLabel", aria-hidden="true")
    .modal-dialog.modal-dialog-centered
        .modal-content
            .modal-header
                h1#joinCampModalLabel.modal-title.fs-5 Csatlakozás táborhoz
                button.btn-close(type="button", data-bs-dismiss="modal", aria-label="Close")
            .modal-body
                p.text-muted.mb-3 Írd be a tábor kódját a csatlakozáshoz! (6-12 karakter)
                form#campJoinForm
                    .mb-3
                        label.form-label(for="campCode") Tábor kódja
                        input#campCode.form-control.text-center(type="text", required, minlength=6 maxlength=12 placeholder="******")
                    button.btn.btn-primary.w-100(type="submit") Csatlakozás
            .modal-footer
                button.btn.btn-danger(type="button", data-bs-dismiss="modal") Bezárás

