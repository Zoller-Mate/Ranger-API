div.modal.fade#paymentModal(tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true")
    div.modal-dialog
        div.modal-content
            div.modal-header
                h5#paymentModalLabel.modal-title Befizetés hozzáadása
                button.btn-close(type="button", data-bs-dismiss="modal", aria-label="Close")
            div.modal-body
                form#paymentForm(data-paymentid="")
                    div.mb-3
                        label.form-label(for="paymentName") Cím
                        input#paymentName.form-control(type="text", required)
                    div.mb-3
                        label.form-label(for="paymentDueDate") Befizetési atáridő
                        input#paymentDueDate.form-control(type="date", required)
                    div.mb-3
                        label.form-label(for="paymentAmount") Összeg
                        div.input-group
                            input#paymentAmount.form-control(type="number" step="0.01" min="0", required)
                            select#paymentCurrency.form-select
