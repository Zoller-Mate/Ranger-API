.modal.fade#passwordResetModal(tabindex="-1", aria-labelledby="passwordResetModalLabel", aria-hidden="true")
  .modal-dialog.modal-dialog-centered
    .modal-content
      .modal-header
        h1#passwordResetModalLabel.modal-title.fs-5 Jelszó visszaállítása
        button.btn-close(type="button", data-bs-dismiss="modal", aria-label="Close")
      .modal-body
        p.text-muted.mb-3 Írj be az email címedet, és küldünk egy linket a jelszó visszaállításához.
        form#passwordResetForm
          .mb-3
            label.form-label(for="resetEmail") Email cím
            input#resetEmail.form-control(type="email", required)
          button.btn.btn-primary.w-100(type="submit") Jelszó visszaállítási link küldése
        .text-center.mt-3
          small
            a(href="#", data-bs-dismiss="modal", data-bs-toggle="modal", data-bs-target="#loginModal") Vissza a bejelentkezéshez
